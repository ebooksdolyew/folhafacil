# Cloudflare Pages — cabeçalhos HTTP
# https://developers.cloudflare.com/pages/configuration/headers/
# X-Robots-Tag em /* vale para qualquer arquivo (HTML, JS, imagens, fontes),
# inclusive os que não têm <meta name="robots">.

/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

# HTML sempre revalidado (garante que o conteúdo novo apareça na hora)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
/infrequencia.html
  Cache-Control: public, max-age=0, must-revalidate
/conciliadorde-planilha.html
  Cache-Control: public, max-age=0, must-revalidate

# Camada de interface compartilhada: revalidada junto com as páginas
/ui/*
  Cache-Control: public, max-age=0, must-revalidate

# Imagens e ícones: cache longo
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=604800

# robots.txt e manifesto: cache curto para permitir atualização rápida
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Bibliotecas com versão fixa: cache longo
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes auto-hospedadas: cache longo
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
