  "description": "Ghub — análise inteligente de ponto eletrônico em PDF",
  "scripts": {
    "build": "node scripts/build-deploy.js",
    "fixtures": "node tests/fixtures/gerar-pdf-sintetico.js tests/fixtures/ponto-sintetico.pdf",
    "pretest": "npm run fixtures",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit.spec.js",
    "test:e2e": "playwright test tests/e2e.spec.js",
    "checksums": "cd vendor && grep -v '^#' CHECKSUMS.txt | grep . | sha256sum -c"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "pdf-lib": "1.17.1"
  }
}
